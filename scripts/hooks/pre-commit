#!/bin/bash
# Refuses commits that could put private banking data on GitHub.
#
# Turned on by `git config core.hooksPath scripts/hooks` (First Time Setup does it).
#
#   1. Bank exports, databases (and their -wal/-shm/-journal/.tmp side files), logs and archives,
#      even if forced past .gitignore.
#   2. Card numbers: masked in the shape Tangerine uses in file names (four digits, x's, then the
#      last four digits), and full ones (13-19 digits that pass the Luhn check).
#   3. Anything listed in .git-denylist: a local, ignored file with one private word or
#      name per line (account digits, people's names, employers). Matching ignores case.
#
# 2 and 3 are privacy_check.py, which the commit-msg hook and scripts/release.sh run too.
# Only ever bypass with `git commit --no-verify` after checking the diff yourself.

set -uo pipefail
ROOT=$(git rev-parse --show-toplevel)
fail=0

blocked=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -Ei '\.(csv|ofx|qfx|qbo|db|db-wal|db-shm|db-journal|sqlite3?|zip|tmp|log)$|(^|/)(Backups|Imported Files|Personal|private|data|Logs)/' || true)
if [[ -n "$blocked" ]]; then
    echo "✗ These files look like bank data or a database and can't be committed:" >&2
    echo "$blocked" | sed 's/^/    /' >&2
    fail=1
fi

# Every added line, whatever it starts with: only git's own "+++ b/file" header is left out.
added=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -Ev '^\+\+\+ ' || true)

if ! command -v python3 >/dev/null; then
    echo "✗ python3 is needed for the card number and .git-denylist checks." >&2
    fail=1
elif ! printf '%s\n' "$added" | python3 "$(dirname "$0")/privacy_check.py" --denylist "$ROOT/.git-denylist" --what "Being added"; then
    fail=1
fi

if [[ $fail -ne 0 ]]; then
    echo "" >&2
    echo "Commit refused to keep private data off GitHub. Remove it and try again." >&2
    exit 1
fi
exit 0
